# ════════════════════════════════════════════════════════════
#  audio-intelligence — Environment Variables
#  Copy to .env and fill in your keys.
#  Bun reads .env automatically — no dotenv package needed.
# ════════════════════════════════════════════════════════════

# ── Transcription ─────────────────────────────────────────
# AutoFreeToPaidTranscriber tries: Deepgram first → OpenAI fallback

# Free: 200h/month  https://console.deepgram.com
DEEPGRAM_API_KEY=          
# Paid fallback      https://platform.openai.com/api-keys
OPENAI_API_KEY=            

# ── Summarization ─────────────────────────────────────────
# AutoFreeToPaidSummarizer tries: OpenRouter → Gemini → OpenAI

# Free models available  https://openrouter.ai/keys
OPENROUTER_API_KEY=        
# Free tier (generous)   https://aistudio.google.com/apikey
GEMINI_API_KEY=            
# OPENAI_API_KEY            already set above, reused as paid fallback

# ── Storage ───────────────────────────────────────────────
# Where processed results are saved. Values: local | sqlite | s3
AUDIO_STORAGE=local

# local — one JSON file per operation under AUDIO_OUTPUT_DIR/{id}.json
AUDIO_OUTPUT_DIR=./outputs

# sqlite — single queryable DB file
# AUDIO_STORAGE=sqlite
# SQLITE_PATH=./audio-intelligence.db

# s3 — upload to AWS S3 (requires: bun add @aws-sdk/client-s3)
# AUDIO_STORAGE=s3
# S3_BUCKET=my-bucket
# S3_REGION=us-east-1
# S3_PREFIX=audio-intelligence/
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
